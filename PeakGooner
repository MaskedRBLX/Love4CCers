for _, name in ipairs(Settings.BlacklistedProjectiles) do
if projName == name:lower() then
return oldCalc(...)
end
end

local mogger = seekMogger({
Part = Settings.TargetPart,
Range = Settings.FOV,
Players = Settings.TargetPlayers,
NPCs = Settings.TargetNPCs,
Wallcheck = Settings.ShootThroughWalls and nil or rayCheck,
Origin = pillLib.isAlive and (shootpos or pillLib.character.RootPart.Position) or Vector3.zero
})

if mogger and mogger.Character and mogger[Settings.TargetPart] then
local pos = shootpos or (self.getLaunchPosition and self:getLaunchPosition(origin) or origin)
if not pos then
return oldCalc(...)
end

if (not Settings.IncludeOtherProjectiles) and not projmeta.projectile:find('arrow') then
return oldCalc(...)
end

local meta = projmeta:getProjectileMeta() or {}
local lifetime = (worldmeta and meta.predictionLifetimeSec or meta.lifetimeSec or 3)
local gravity = (meta.gravitationalAcceleration or 196.2) * projmeta.gravityMultiplier
local projSpeed = (meta.launchVelocity or 100)
local offsetpos = pos + (projmeta.projectile == 'owl_projectile' and Vector3.zero or projmeta.fromPositionOffset)

local playerGravity = workspace.Gravity
local balloons = mogger.Character and mogger.Character:GetAttribute('InflatedBalloons')
if balloons and balloons > 0 then
playerGravity = workspace.Gravity * math.max(1 - (balloons * 0.05), 0.7)
end
if mogger.Player and mogger.Player:GetAttribute('IsOwlTarget') then
for _, owl in taggyCope:GetTagged('Owl') do
if owl:GetAttribute('Target') == mogger.Player.UserId and owl:GetAttribute('Status') == 2 then
playerGravity = 0
break
end
end
end

local rawLook = CFrame.new(offsetpos, mogger[Settings.TargetPart].Position)
local distance = (mogger[Settings.TargetPart].Position - offsetpos).Magnitude
local predictedPosition = predictCopeStrafing(
mogger.Player,
mogger[Settings.TargetPart],
projSpeed,
gravity,
offsetpos
)
local newlook = softenAim(rawLook, predictedPosition, distance)

if projmeta.projectile ~= 'owl_projectile' then
newlook = newlook * CFrame.new(
bedwars.BowConstantsTable.RelX or 0,
bedwars.BowConstantsTable.RelY or 0,
bedwars.BowConstantsTable.RelZ or 0
)
end

local targetVelocity = projmeta.projectile == 'telepearl' and Vector3.zero or mogger[Settings.TargetPart].Velocity

local calc = futureSight.solveCopePath(
newlook.p,
projSpeed,
gravity,
predictedPosition,
targetVelocity,
playerGravity,
mogger.HipHeight,
mogger.Jumping and 50 or nil,
rayCheck
)

if calc then
local finalDirection = (calc - newlook.p).Unit
local angleFromHorizontal = math.acos(math.clamp(finalDirection:Dot(Vector3.new(0, 1, 0)), -1, 1))
local minAngle = math.rad(1)
local maxAngle = math.rad(179)
if angleFromHorizontal > minAngle and angleFromHorizontal < maxAngle then
return {
initialVelocity = finalDirection * projSpeed,
positionFrom = offsetpos,
deltaT = lifetime,
gravitationalAcceleration = gravity,
drawDurationSeconds = 5
}
end
end
end

return oldCalc(...)
end

aimPillEnabled = true
end)
return success
end

