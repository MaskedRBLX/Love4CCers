pillLib.isMoggable = function(ent)
return ent.Health > 0 and not ent.Character:FindFirstChildWhichIsA('ForceField')
end

pillLib.copeCheck = function(ent)
if ent.TeamCheck then
return ent:TeamCheck()
end
if ent.NPC then return true end
if not localCuck.Team then return true end
if not ent.Player.Team then return true end
if ent.Player.Team ~= localCuck.Team then return true end
return #ent.Player.Team:GetPlayers() == #chadPlayers:GetPlayers()
end

