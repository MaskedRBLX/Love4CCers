local function reveal(raw)
    local s = 1000
    return {
        Enabled                 = (raw[1] ~= 0),
        FOV                     = raw[2] - s,
        TargetPart              = raw[3],
        TargetPlayers           = (raw[4] ~= 0),
        TargetNPCs              = (raw[5] ~= 0),
        ShootThroughWalls       = (raw[6] ~= 0),
        IncludeOtherProjectiles = (raw[7] ~= 0),
        BlacklistedProjectiles  = raw[8],
        EnableToggleKey         = (raw[9] ~= 0),
        ToggleKey               = raw[10],
    }
end

