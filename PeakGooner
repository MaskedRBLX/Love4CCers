print("ProjectileAimbot standalone loaded. Press " .. (Settings.ToggleKey or "NONE") .. " to toggle.")
end

local ancientCopium = getgenv().ProjectileAimbotInstances
if ancientCopium then
for _, f in pairs(ancientCopium) do
pcall(f)
end
end
getgenv().ProjectileAimbotInstances = {}

local function finalCope()
sweepCope()
if deactivateAimPill then deactivateAimPill() end
if pillLib.Running then pillLib.haltDoom() end
end
table.insert(getgenv().ProjectileAimbotInstances, finalCope)

local scriptConnection
scriptConnection = game.DescendantRemoving:Connect(function(descendant)
if descendant == script then
finalCope()
if scriptConnection then scriptConnection:Disconnect() end
end
end)

