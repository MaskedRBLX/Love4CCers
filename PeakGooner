local seekMogger = function(options)
options = options or {}
local mouseLocation = options.MouseOrigin or doomerCursor()
local sortingTable = {}

if not pillLib.isAlive then return nil end

for _, v in pillLib.List do
if not options.Players and v.Player then continue end
if not options.NPCs and v.NPC then continue end
if not v.Targetable then continue end

local targetPart = v[options.Part or 'RootPart']
if not targetPart then continue end

local position, vis = doomCam:WorldToViewportPoint(targetPart.Position)
if not vis then continue end

local mag = (mouseLocation - Vector2.new(position.x, position.y)).Magnitude
if mag > (options.Range or 1000) then continue end

if pillLib.isMoggable(v) then
table.insert(sortingTable, {
Entity = v,
Magnitude = mag,
Position = position
})
end
end

table.sort(sortingTable, options.Sort or function(a, b)
return a.Magnitude < b.Magnitude
end)

for _, v in sortingTable do
if options.Wallcheck then
if pillLib.wallCope(options.Origin or pillLib.character.HumanoidRootPart.Position, v.Entity[options.Part or 'RootPart'].Position, options.Wallcheck) then
continue
end
end
table.clear(options)
table.clear(sortingTable)
return v.Entity
end

table.clear(sortingTable)
table.clear(options)
return nil
end

